# ASOX SOC topology (PROJECT.md section 4).
# Copy to topology.env (git-ignored), adjust, then run scripts/render-env.sh
# (soc.sh init does this for you).

# single      = all nodes on this machine, joined through the soc-net network
# distributed = nodes on several machines, reached through published ports
DEPLOY_MODE=single

# standard = 16 GB+ hosts, low = 8 GB hosts (PROJECT.md section 8)
MEM_PROFILE=standard

# Prefix for compose project names: <SOC_INSTANCE>-<node> (e.g. asox-core).
# Lowercase letters, digits and dashes only.
SOC_INSTANCE=asox

# Host of each node (only used when DEPLOY_MODE=distributed)
CORE_HOST=192.168.1.10
CASES_HOST=192.168.1.11
INTEL_HOST=192.168.1.12

# Optional: pfSense/router syslog sources the Wazuh manager accepts on 514/udp
# (empty = only the manager's own Docker networks). Comma-separated IPv4
# addresses or CIDRs, no spaces, e.g. 192.168.1.1,10.0.5.0/24
# SYSLOG_ALLOWED_IPS=

# Optional, C9 response actions (docs/decisions.md A106). live only on a
# machine meant to block (the demo); the default dry_run sends nothing.
# RESPONSE_MODE=dry_run            # C9: dry_run (default) or live
# Addresses n8n never blocks, mandatory with live: this network's SOC
# machine, gateway, DNS and Wazuh manager. The agents' own addresses are
# already protected by n8n (protect_agent_ips); never list the attacker.
# Comma-separated IPv4 addresses or CIDRs, no spaces, e.g. 192.168.1.64/32,192.168.1.1
# RESPONSE_PROTECTED_CIDRS=        # C9: never blocked; comma-separated IPv4/CIDR
