# API keys of the online analyzers in analyzers.json (owner: Cortex + MISP).
# Copy to analyzer-keys.env (git-ignored by this folder's .gitignore), fill
# in the keys you have, then run nodes/cases/cortex/analyzers/analyzers.sh apply.
# An analyzer whose key is blank here is skipped. Never commit real keys.

# AbuseIPDB (IP reputation). Free: 1000 checks/day. abuseipdb.com > API.
ABUSEIPDB_API_KEY=
# AlienVault OTX (IP, domain, URL, hash). Free. otx.alienvault.com > Settings.
OTX_API_KEY=
# abuse.ch Auth-Key, used by URLhaus and MalwareBazaar. Free. auth.abuse.ch.
ABUSECH_AUTH_KEY=
# VirusTotal. Free: 4 lookups/min, 500/day, shared with any other tool using
# the same key (e.g. Wazuh's VirusTotal integration). virustotal.com > API key.
VIRUSTOTAL_API_KEY=
