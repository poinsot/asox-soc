# Template for this node's .env. Do not copy by hand: scripts/render-env.sh
# renders .env from this file and topology.env (soc.sh init runs it).
#
# How render-env.sh fills each key:
#   - topology-derived keys (instance, URLs, BIND_ADDR, heaps, mem limits,
#     paths) are always recomputed from topology.env;
#   - value __secret__    : random secret generated once, then kept;
#   - value __bootstrap__ : filled by bootstrap.sh (API keys), then kept;
#   - anything else       : copied from this file (e.g. pinned image tags).
# Values below are the single-host / standard-profile defaults, which CI
# uses to validate the compose files.

# --- Instance (derived) ---
SOC_INSTANCE=asox
DEPLOY_MODE=single
MEM_PROFILE=standard
BIND_ADDR=127.0.0.1

# --- Service URLs (derived) ---
ELASTICSEARCH_URL=http://elasticsearch:9200
N8N_WEBHOOK_URL=http://n8n:5678
THEHIVE_URL=http://thehive:9000
CORTEX_URL=http://cortex:9001
MISP_URL=https://misp-nginx:8443

# --- Paths (derived) ---
# Absolute host path of nodes/cases/cortex/jobs on this machine.
CORTEX_JOBS_HOST_DIR=/home/user/asox-soc/nodes/cases/cortex/jobs

# --- Memory profile (derived) ---
CASSANDRA_HEAP=1g
CASSANDRA_MEM=1600m
ES_HEAP=1g
ES_MEM=1600m
THEHIVE_HEAP=1g
THEHIVE_MEM=1300m
CORTEX_HEAP=512m
CORTEX_MEM=700m

# --- Pinned images (docs/decisions.md) ---
CASSANDRA_IMAGE=cassandra:4.1.12
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.21
THEHIVE_IMAGE=strangebee/thehive:5.7.6
CORTEX_IMAGE=thehiveproject/cortex:4.1.0
