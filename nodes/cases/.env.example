# Template for this node's .env. Do not copy by hand: scripts/render-env.sh
# renders .env from this file and topology.env (soc.sh init runs it).
#
# How render-env.sh fills each key:
#   - topology-derived keys (instance, URLs, BIND_ADDR, heaps, mem limits,
#     paths) are always recomputed from topology.env;
#   - value __secret__    : random secret generated once, then kept;
#   - value __bootstrap__ : filled by bootstrap.sh (API keys), then kept;
#   - value __from:<node>__ : copied from nodes/<node>/.env on this machine;
#   - anything else       : copied from this file (e.g. pinned image tags).
# Values below are the single-host / standard-profile defaults, which CI
# uses to validate the compose files.

# --- Instance (derived) ---
SOC_INSTANCE=asox
DEPLOY_MODE=single
MEM_PROFILE=standard
BIND_ADDR=127.0.0.1

# --- Service URLs (derived) ---
ELASTICSEARCH_URL=http://elasticsearch:9200
N8N_WEBHOOK_URL=http://n8n:5678
THEHIVE_URL=http://thehive:9000
CORTEX_URL=http://cortex:9001
MISP_URL=https://misp-nginx:8443

# --- Intra-node addresses (aliases on the node's own network) ---
CASSANDRA_HOSTNAME=cassandra
ELASTICSEARCH_HOSTNAME=elasticsearch

# --- Paths and host IDs (derived) ---
# Absolute host path of nodes/cases/cortex/jobs on this machine.
CORTEX_JOBS_HOST_DIR=/home/user/asox-soc/nodes/cases/cortex/jobs
# Cortex runs as the host user (owner of the job directory), with the group
# of the host's Docker socket (docs/decisions.md A50).
CORTEX_UID=1000
CORTEX_GID=1000
DOCKER_GID=989
# Docker network of analyzer containers: soc-net (single) or bridge (distributed).
CORTEX_ANALYZER_NETWORK=soc-net

# --- Memory profile (derived) ---
CASSANDRA_HEAP=1g
CASSANDRA_NEWSIZE=256m
CASSANDRA_MEM=1600m
ES_HEAP=1g
ES_MEM=2400m
THEHIVE_HEAP=1g
THEHIVE_MEM=1900m
CORTEX_HEAP=512m
CORTEX_MEM=650m
# Memory limit of each analyzer container, in bytes (no swap).
CORTEX_ANALYZER_MEM=268435456

# --- Pinned images (docs/decisions.md) ---
CASSANDRA_IMAGE=cassandra:4.1.12
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.21
THEHIVE_IMAGE=strangebee/thehive:5.7.6
CORTEX_IMAGE=thehiveproject/cortex:4.1.0

# --- Elasticsearch (shared by TheHive and Cortex) ---
# Password of the built-in "elastic" user, set on the first start only.
ES_PASSWORD=__secret__

# --- TheHive ---
# Session secret.
THEHIVE_SECRET=__secret__
# Platform administrator (image default admin@thehive.local; bootstrap.sh
# replaces the default password with this one).
THEHIVE_ADMIN_USER=admin@thehive.local
THEHIVE_ADMIN_PASSWORD=__secret__
# SOC organisation, its analyst (profile org-admin, UI only: bootstrap.sh
# never uses this password), and the API user for n8n (C3).
THEHIVE_ORG=SOC
THEHIVE_ANALYST_USER=analyst@asox.local
THEHIVE_ANALYST_PASSWORD=__secret__
THEHIVE_N8N_USER=n8n@asox.local
THEHIVE_N8N_API_KEY=__bootstrap__
# Service account (org-admin in SOC) that bootstrap.sh uses to write the
# organisation's notification rule (C4). Its API key is created, used and
# revoked on every run: never stored.
THEHIVE_BOOTSTRAP_USER=bootstrap@asox.local
# Token TheHive's webhook to n8n sends (C4; TheHive webhooks can only send it
# as "Authorization: Bearer <token>"). Copied from nodes/core/.env on this
# machine; in distributed mode, paste it from the core machine's .env.
N8N_WEBHOOK_TOKEN=__from:core__

# --- Cortex ---
# Session secret.
CORTEX_SECRET=__secret__
# Superadmin (organisation "cortex": manages organisations and users only).
CORTEX_ADMIN_USER=admin
CORTEX_ADMIN_PASSWORD=__secret__
# SOC organisation and its administrator (enables and configures analyzers).
CORTEX_ORG=SOC
CORTEX_ORGADMIN_USER=soc-admin
CORTEX_ORGADMIN_PASSWORD=__secret__
# API users (roles read + analyze): TheHive's connector (C5) and n8n (C6).
CORTEX_THEHIVE_USER=thehive
CORTEX_THEHIVE_API_KEY=__bootstrap__
CORTEX_N8N_USER=n8n
CORTEX_N8N_API_KEY=__bootstrap__
# MISP API key of the read-only MISP user for Cortex's MISP analyzer (C7),
# created by bootstrap.sh intel. Copied from nodes/intel/.env on this machine;
# in distributed mode, paste it from the intel machine's .env.
MISP_CORTEX_API_KEY=__from:intel__
