      "id": "7e9f1197-f296-5df6-a143-cb74c6f683df",
      "name": "Writeback (lib-thehive-writeback)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2600,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "const u = $('Upsert (lib-thehive-upsert-alert)').first().json;\nconst r = $input.first().json;\nreturn [{ json: {\n  outcome: u.duplicate ? 'duplicate' : 'created',\n  wazuh_alert_id: u.wazuh_alert_id,\n  thehive_alert_id: u.thehive_alert_id,\n  writeback: r.ok ? (r.written ? 'written' : 'already written') : 'failed (parked by lib-error)',\n  playbook: $workflow.name,\n} }];\n"
      },
      "id": "85eac449-e6c7-577b-b84b-f2186266ab2d",
      "name": "Outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize or upsert handed the alert to lib-error, which parked it.\nconst r = $input.first().json;\nconst alert = $('Context').first().json.alert;\nreturn [{ json: {\n  outcome: 'parked',\n  wazuh_alert_id: r.wazuh_alert_id ?? (typeof alert?.id === 'string' ? alert.id : null),\n  error: r.error_class ?? r.stage ?? null,\n  message: r.message ?? null,\n  playbook: $workflow.name,\n} }];\n"
      },
      "id": "ec0eca37-d89e-5864-bb80-62ccf5f35215",
      "name": "Parked outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        120
      ]
    }
