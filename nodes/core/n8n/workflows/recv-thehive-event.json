    {
      "parameters": {
        "jsCode": "// Routing table (N8N-1.5), first match wins. The summary above is kept in this\n// execution for every event, routed or not.\nconst s = $('Event summary').first().json;\nconst body = $('TheHive event').first().json.body ?? {};\nconst cfg = $input.first().json;\nconst details = body.details !== null && typeof body.details === 'object' ? body.details : {};\nconst op = s.operation;\nconst type = s.object_type;\nconst has = (k) => Object.prototype.hasOwnProperty.call(details, k);\nlet route;\nlet status;\nif (s.actor === cfg.thehive.n8n_user) {\n  // TheHive's webhook reports n8n's own writes back to n8n: stop here.\n  route = 'loop'; status = `ignored: caused by ${cfg.thehive.n8n_user} (loop prevention)`;\n} else if (op === 'delete') {\n  // No object and no useful details (ALERT-TO-THEHIVE §6): open question, N8N-1.5.\n  route = 'delete'; status = 'ignored: delete (open question, N8N-1.5)';\n} else if (type === 'Alert' && op === 'update' && has('caseId')) {\n  route = 'alert-promoted'; status = 'stub: alert promoted to a case';\n} else if (type === 'Alert' && op === 'update' && has('status')) {\n  route = 'alert-status'; status = 'stub: alert status changed';\n} else if (type === 'Case' && op === 'create') {\n  route = 'case-created'; status = 'stub: case created';\n} else if (type === 'Case' && op === 'update' && (has('status') || has('stage'))) {\n  route = 'case-status'; status = 'stub: case status changed (closing included)';\n} else if (['Task', 'Log', 'Comment'].includes(type)) {\n  route = 'analyst-activity'; status = 'stub: analyst activity (task, log, comment)';\n} else {\n  route = 'other'; status = 'recorded: no handler';\n}\nreturn [{ json: { ...s, route, status, details_keys: Object.keys(details) } }];\n"
      },
