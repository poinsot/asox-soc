    {
      "parameters": {
        "jsCode": "// Slot rows to add or remove; at start-up only, the slots and running rows\n// the stopped process left (claimed before start - restart_grace_s).\nconst cfg = $('Config (lib-config)').first().json.alert_queue;\nconst ev = $('n8n started or workflow published').first().json;\nconst startup = ev.event === 'Instance started';\nconst now = Date.now();\nconst cutoff = now - cfg.restart_grace_s * 1000;\nconst rows = (name) => $(name).all().map((i) => i.json).filter((r) => r.id !== undefined);\nconst wanted = Array.from({ length: cfg.slots }, (_, i) => `slot-${i + 1}`);\nconst keep = new Map();\nconst remove = [];\nfor (const r of rows('Slots')) {\n  if (!wanted.includes(r.slot) || keep.has(r.slot)) remove.push({ id: r.id, slot: r.slot }); else keep.set(r.slot, r);\n}\nconst add = wanted.filter((s) => !keep.has(s)).map((slot) => ({ slot }));\nconst free = startup\n  ? [...keep.values()].filter((r) => r.status !== 'free' && Number(r.held_ms) < cutoff).map((r) => ({ id: r.id, slot: r.slot, claim: r.claim }))\n  : [];\nconst requeue = startup\n  ? rows('Running rows').filter((r) => Number(r.started_ms) < cutoff).map((r) => {\n    const exhausted = Number(r.attempts) >= cfg.max_attempts;\n    return { id: r.id, claim: r.claim, alert_id: r.alert_id, attempts: Number(r.attempts),\n      next: exhausted ? 'failed' : 'pending',\n      note: exhausted\n        ? `failed: n8n stopped during attempt ${r.attempts} of ${cfg.max_attempts}; parked`\n        : `requeued at start-up: n8n stopped during attempt ${r.attempts}` };\n  })\n  : [];\nreturn [{ json: { event: ev.event, startup, now, cutoff, add, remove, free, requeue,\n  delete_done_before: now - cfg.keep_done_h * 3600 * 1000, max_attempts: cfg.max_attempts } }];\n"
      },
