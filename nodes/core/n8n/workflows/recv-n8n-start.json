    {
      "parameters": {
        "jsCode": "// Rows marked failed above (compare-and-set took effect) -> lib-error, with the alert id.\nconst p = $('Plan').first().json;\nconst done = new Set($('Requeue or fail row (compare-and-set)').all().map((i) => i.json).filter((r) => r.status === 'failed').map((r) => r.id));\nreturn p.requeue.filter((r) => r.next === 'failed' && done.has(r.id)).map((r) => ({ json: {\n  error_class: 'queue_attempts_exhausted', stage: 'alert queue (recv-n8n-start)', workflow: $workflow.name,\n  execution_id: $execution.id, node: 'Requeue or fail row (compare-and-set)', wazuh_alert_id: r.alert_id,\n  thehive_alert_id: null, http_status: null, error_code: null, attempts: r.attempts,\n  message: `alert ${r.alert_id}: n8n stopped during attempt ${r.attempts} of ${p.max_attempts}; not retried`,\n  payload: { queue_row: r.id } } }));\n"
      },
