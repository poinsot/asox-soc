    {
      "parameters": {
        "jsCode": "// lib-route-alert failed (a broken routing table in lib-config): park the\n// alert with its id and payload, so it can be replayed once fixed.\nconst d = $('Intake decision').first().json;\nconst err = $input.first().json.error;\nreturn [{ json: {\n  error_class: 'unknown',\n  stage: 'route',\n  workflow: $workflow.name,\n  execution_id: $execution.id,\n  node: 'Route (lib-route-alert)',\n  wazuh_alert_id: d.wazuh_alert_id,\n  thehive_alert_id: null,\n  message: 'routing failed: ' + (typeof err === 'string' ? err : err?.message ?? JSON.stringify($input.first().json).slice(0, 500)),\n  payload: d.alert,\n} }];\n"
      },
      "id": "09c499c7-540d-5043-b810-de3994f6782f",
