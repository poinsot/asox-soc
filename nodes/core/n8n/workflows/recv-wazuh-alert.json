    {
      "parameters": {
        "jsCode": "// Queue-unavailable branch: the route is recorded here and passed to the\n// playbook, which puts it in TheHive (caseTemplate, writeback). For queued\n// alerts the route is on the lib-alert-queue-drain execution.\nconst d = $('Intake decision').first().json;\nconst route = $input.first().json.route;\nreturn [{ json: {\n  status: `${d.queue_error}: playbook started directly, not queued; routed: ${route.route_id} -> ${route.playbook}` + (route.fallback ? ` (fallback from ${route.fallback.wanted})` : ''),\n  route,\n  wazuh_alert_id: d.wazuh_alert_id,\n  alert: d.alert, config: d.config, recv_execution_id: d.recv_execution_id,\n} }];\n"
      },
