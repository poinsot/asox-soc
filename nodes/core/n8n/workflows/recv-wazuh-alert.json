    {
      "parameters": {
        "jsCode": "// Queue-unavailable branch only. Intake exclusions (lib-config), the same\n// rule lib-alert-queue-drain's Decide applies to queued alerts. The level\n// filter already ran (Below the threshold?).\nconst { alert, queue_error } = $('Queue unavailable: run directly').first().json;\nconst cfg = $input.first().json;\nconst rule = alert !== null && typeof alert === 'object' ? alert.rule : undefined;\nconst groups = rule !== null && typeof rule === 'object' && Array.isArray(rule.groups) ? rule.groups : [];\nconst ex = (cfg.intake_exclusions ?? []).find((e) => groups.includes(e.rule_group));\nreturn [{ json: {\n  decision: ex ? 'skipped' : 'handoff',\n  status: ex ? `skipped: ${ex.label}` : `${queue_error}: handed off to the router`,\n  queue_error,\n  wazuh_alert_id: typeof alert?.id === 'string' ? alert.id : null,\n  rule_id: rule?.id ?? null,\n  alert, config: cfg, recv_execution_id: $execution.id,\n} }];\n"
      },
      "id": "e87c7def-1f8e-5ea2-a5c2-4e02fac06898",
