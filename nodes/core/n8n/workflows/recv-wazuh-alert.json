    {
      "parameters": {
        "jsCode": "// The queue table is missing or refused the row (the 200 is already sent):\n// run the playbook directly, without waiting (the behaviour before the\n// queue), so the alert isn't lost. Only the body goes further: the request\n// headers carry the webhook token.\nconst e = $('Queue (asox_alert_queue)').first().json.error;\nreturn [{ json: {\n  alert: $('Wazuh alert').first().json.body,\n  queue_error: `queue unavailable (${typeof e === 'string' ? e : e?.message ?? 'error'})`,\n} }];\n"
      },
      "id": "3643c435-6a84-5344-b298-462dd2679295",
      "name": "Queue unavailable: run directly",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        20
      ]
    },
