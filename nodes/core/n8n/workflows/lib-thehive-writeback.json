    {
      "parameters": {
        "jsCode": "// Explicit lib-error input (N8N-2.5): keeps the Wazuh alert ID, which n8n's\n// Error Trigger would not have. Handles both a failed HTTP status (item from\n// the interpreting Code node) and a connection error (HTTP node error output).\nconst j = $input.first().json;\nconst ctx = (() => { const i = $('Called by a workflow').first().json; return { context: i.context, wazuh_alert_id: i.wazuh_alert_id, thehive_alert_id: i.thehive_alert_id, payload: { actions: i.actions } }; })();\nconst err = j.error;\nconst message = j.message ?? (typeof err === 'string' ? err : err?.message) ?? JSON.stringify(j).slice(0, 500);\nreturn [{ json: {\n  stage: 'thehive: ' + (j.stage ?? $prevNode.name),\n  workflow: $workflow.name,\n  execution_id: ctx.context?.n8n_execution_id ?? $execution.id,\n  sub_execution_id: $execution.id,\n  node: j.node ?? $prevNode.name,\n  wazuh_alert_id: ctx.wazuh_alert_id ?? null,\n  thehive_alert_id: ctx.thehive_alert_id ?? null,\n  http_status: j.http_status ?? err?.httpCode ?? null,\n  error_code: err?.code ?? err?.cause?.code ?? null,\n  message,\n  // What was being sent, for a later replay (N8N-6.3): kept on every failure.\n  payload: j.payload ?? ctx.payload ?? null,\n} }];\n"
      },
      "id": "0c988845-b9a0-544f-8d30-875b13c2cc7e",
      "name": "Error input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ]
    },
