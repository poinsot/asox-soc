    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.statusCode === 201) return [{ json: { ok: true, written: true, comment_id: r.body._id } }];\nreturn [{ json: { ok: false, status: 'failed', http_status: r.statusCode, stage: 'Post TheHive comment',\n  message: `HTTP ${r.statusCode}: ${JSON.stringify(r.body)}`.slice(0, 1000) } }];\n"
      },
