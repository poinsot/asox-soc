    {
      "parameters": {
        "jsCode": "// Another run claimed this row first: try the next one.\nreturn [{ json: { via: 'claim lost' } }];"
      },
      "id": "14c95c27-a6c6-5c65-9230-00e8ea94245c",
      "name": "Row lost",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7680,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// After each row (N8N-1.7): what happened to it, and whether the run goes on.\n// Only ids, outcomes and durations are kept here (the run's data stays small).\n// A row that is still pending (claim lost, given back, failed attempt) is\n// skipped for the rest of this run, so it is never retried at once.\nconst pick = $('Pick next row').first().json;\nconst st = pick.state;\nconst row = pick.next;\nconst r = $input.first().json;\nconst ms = Date.now() - pick.picked_ms;\nlet entry;\nlet stop = null;\nif (r.via === 'claim lost') {\n  entry = { id: row.id, result: 'claim lost' };\n} else if (r.row_id === row.id && r.outcome !== undefined) {\n  entry = { id: row.id, alert_id: row.alert_id, result: r.row_status, outcome: r.outcome, ms };\n} else {\n  // lib-alert-queue-drain itself failed: the row keeps our claim and is requeued\n  // after running_timeout_s. Stop instead of failing the next rows the same way.\n  const e = r.error;\n  entry = { id: row.id, alert_id: row.alert_id, result: 'drain failed', ms };\n  stop = `drain failed on row ${row.id}: ${typeof e === 'string' ? e : (e?.message ?? 'no result')}`.slice(0, 300);\n}\nconst drained = entry.result === 'claim lost' ? st.drained : [...st.drained, entry];\nconst skip = entry.result === 'done' || entry.result === 'failed' ? st.skip : [...st.skip, row.id];\nconst state = { ...st, iterations: st.iterations + 1, drained, skip };\nreturn [{ json: { state, stop, go: stop === null, last: entry } }];"
      },
