      },
      "id": "63dd72a6-9ae4-556d-8f3e-5496b976d20f",
      "name": "Config (lib-config)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const q = $('Config (lib-config)').first().json.alert_queue;\nconst now = Date.now();\nconst rows = (name) => $(name).all().map((i) => i.json).filter((r) => r.id !== undefined);\nconst pending = rows('Pending rows');\nconst running = rows('Running rows');\n// A running row past the timeout: its run hung (a crash is handled at start-up\n// by recv-n8n-start). Requeue it, or fail and park it after max_attempts.\nconst stale = running.filter((r) => Number(r.started_ms) < now - q.running_timeout_s * 1000).map((r) => {\n  const exhausted = Number(r.attempts) >= q.max_attempts;\n  return { id: r.id, claim: r.claim, alert_id: r.alert_id, attempts: Number(r.attempts), next: exhausted ? 'failed' : 'pending',\n    note: `${exhausted ? 'failed' : 'requeued'}: attempt ${r.attempts} still running after ${q.running_timeout_s} s` + (exhausted ? '; parked' : '') };\n});\nconst n = pending[0];\nreturn [{ json: {\n  now, q,\n  depth: { pending: pending.length >= 50 ? '50+' : pending.length, running: running.length },\n  stale,\n  next: n ? { id: n.id, claim: n.claim, attempts: Number(n.attempts), alert_id: n.alert_id } : null,\n  delete_done_before: now - q.keep_done_h * 3600 * 1000,\n} }];\n"
      },
