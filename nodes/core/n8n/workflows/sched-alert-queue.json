      "parameters": {
        "jsCode": "// Every 5 s: an empty queue ends the run here (not saved). A missing table\n// (before recv-n8n-start ran) reads as empty: recv-wazuh-alert then runs the\n// playbook directly.\nconst rows = (name) => $(name).all().map((i) => i.json).filter((r) => r.id !== undefined);\nconst pending = rows('Pending rows').length;\nconst running = rows('Running rows').length;\nreturn [{ json: { work: pending + running > 0, pending, running } }];\n"
      },
