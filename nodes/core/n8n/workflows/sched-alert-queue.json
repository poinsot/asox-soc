      "parameters": {
        "jsCode": "// A free slot, or one held longer than the row timeout plus a margin (its\n// holder died without recv-n8n-start freeing it). None: every slot is busy.\nconst p = $('Plan').first().json;\nconst lease = (p.q.running_timeout_s + p.q.slot_margin_s) * 1000;\nconst slots = $('Slots').all().map((i) => i.json).filter((r) => r.id !== undefined);\nconst s = slots.find((r) => r.status === 'free') ?? slots.find((r) => Number(r.held_ms) < p.now - lease);\nconst rand = () => Math.random().toString(36).slice(2, 10);\nreturn [{ json: { slot: s ? { id: s.id, name: s.slot, observed: s.claim, reclaimed: s.status !== 'free',\n  token: `slot:${$execution.id}:${rand()}` } : null } }];\n"
      },
