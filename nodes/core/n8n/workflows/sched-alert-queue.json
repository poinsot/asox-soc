      "parameters": {
        "jsCode": "const p = $('Plan').first().json;\nconst failed = new Set($('Requeue or fail stale row (compare-and-set)').all().map((i) => i.json).filter((r) => r.status === 'failed').map((r) => r.id));\nreturn p.stale.filter((r) => r.next === 'failed' && failed.has(r.id)).map((r) => ({ json: {\n  error_class: 'queue_attempts_exhausted', stage: 'alert queue (sched-alert-queue)', workflow: $workflow.name,\n  execution_id: $execution.id, node: 'Requeue or fail stale row (compare-and-set)', wazuh_alert_id: r.alert_id,\n  thehive_alert_id: null, http_status: null, error_code: null, attempts: r.attempts,\n  message: `alert ${r.alert_id}: ${r.note}`, payload: { queue_row: r.id } } }));\n"
      },
