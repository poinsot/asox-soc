    {
      "parameters": {
        "jsCode": "// Loop step (N8N-1.7): the oldest pending row this run hasn't skipped, until\n// the run reaches max_rows_per_run rows or max_run_s (checked before each claim:\n// a row in progress is never cut short). The next tick picks up a freed slot.\n// Without these settings: one row per run, as before N8N-1.7.\nconst p = $('Plan').first().json;\nconst q = p.q;\nconst st = $('Record row').isExecuted\n  ? $('Record row').first().json.state\n  : { started_ms: p.now, iterations: 0, drained: [], skip: [] };\nconst maxRows = Number(q.max_rows_per_run ?? 1);\nconst maxRunS = Number(q.max_run_s ?? 240);\nconst maxRunMs = maxRunS * 1000;\nconst now = Date.now();\nconst skip = new Set(st.skip);\nconst n = $('Next pending row').all().map((i) => i.json)\n  .find((r) => r.id !== undefined && !skip.has(r.id));\nlet stop = null;\nif (st.drained.length >= maxRows) stop = `row limit reached (${maxRows})`;\nelse if (st.iterations >= maxRows + 5) stop = `iteration limit reached (${maxRows + 5})`;\nelse if (now - st.started_ms >= maxRunMs) stop = `time limit reached (${maxRunS} s)`;\nelse if (!n) stop = 'no pending row left';\nconst rand = () => Math.random().toString(36).slice(2, 10);\nreturn [{ json: {\n  state: st, stop, picked_ms: now,\n  next: stop === null ? { id: n.id, claim: n.claim, attempts: Number(n.attempts), alert_id: n.alert_id } : null,\n  token: `row:${$execution.id}:${rand()}`,\n} }];"
      },
