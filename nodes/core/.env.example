# Template for this node's .env. Do not copy by hand: scripts/render-env.sh
# renders .env from this file and topology.env (soc.sh init runs it).
#
# How render-env.sh fills each key:
#   - topology-derived keys (instance, URLs, BIND_ADDR, heaps, mem limits,
#     paths) are always recomputed from topology.env;
#   - value __secret__    : random secret generated once, then kept;
#   - value __bootstrap__ : filled by bootstrap.sh (API keys), then kept;
#   - value __from:<node>__ : copied from nodes/<node>/.env on this machine;
#   - anything else       : copied from this file (e.g. pinned image tags).
# Values below are the single-host / standard-profile defaults, which CI
# uses to validate the compose files.

# --- Instance (derived) ---
SOC_INSTANCE=asox
DEPLOY_MODE=single
MEM_PROFILE=standard
BIND_ADDR=127.0.0.1

# --- Service URLs (derived) ---
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
N8N_WEBHOOK_URL=http://n8n:5678
THEHIVE_URL=http://thehive:9000
CORTEX_URL=http://cortex:9001
WAZUH_MANAGER_ADDR=wazuh-manager

# --- Memory profile (derived) ---
INDEXER_HEAP=1g
INDEXER_MEM=2g
WAZUH_MANAGER_MEM=700m
# n8n: Node.js heap in MB (the container needs ~2x this)
N8N_HEAP=384
N8N_MEM=800m
N8N_POSTGRES_MEM=200m
GRAFANA_MEM=256m

# --- n8n ---
# Encryption key of n8n's credentials (never change it once set: existing
# credentials become unreadable).
N8N_ENCRYPTION_KEY=__secret__
# Used only with the optional "pg" profile.
N8N_POSTGRES_PASSWORD=__secret__
# n8n UI owner (created by bootstrap.sh on first start).
N8N_OWNER_EMAIL=admin@asox.local
N8N_OWNER_PASSWORD=__secret__
# Shared token for n8n webhooks, checked by the receiving workflows: sent by
# Wazuh (C1) as header X-ASOX-Token, and by TheHive (C4) as
# "Authorization: Bearer <token>" (its webhooks can't send other headers).
N8N_WEBHOOK_TOKEN=__secret__
# n8n public API key for the scripts (created by bootstrap.sh; limited scopes).
N8N_API_KEY=__bootstrap__
# C3 / C6: API keys of n8n's users in TheHive (Service account) and Cortex,
# created by bootstrap.sh cases. Copied from nodes/cases/.env on this
# machine; in distributed mode, paste them from the cases machine's .env.
THEHIVE_N8N_API_KEY=__from:cases__
CORTEX_N8N_API_KEY=__from:cases__
# Non-secret, derived by render-env.sh (R-18): true when the rendered
# THEHIVE_N8N_API_KEY above is non-empty, else false. n8n's workflows skip
# TheHive while it is false (core without cases). Must stay after
# THEHIVE_N8N_API_KEY. bootstrap.sh core recreates n8n when it changes.
THEHIVE_ENABLED=true
# Execution pruning.
N8N_EXECUTIONS_MAX_AGE_HOURS=168
N8N_EXECUTIONS_MAX_COUNT=10000

# --- Pinned images (docs/decisions.md) ---
WAZUH_MANAGER_IMAGE=wazuh/wazuh-manager:4.14.8
WAZUH_INDEXER_IMAGE=wazuh/wazuh-indexer:4.14.8
WAZUH_CERTS_GENERATOR_IMAGE=wazuh/wazuh-certs-generator:0.0.4
N8N_IMAGE=n8nio/n8n:2.40.7
N8N_POSTGRES_IMAGE=postgres:16.15-alpine
GRAFANA_IMAGE=grafana/grafana:12.4.11
GRAFANA_OPENSEARCH_PLUGIN_VERSION=2.34.4

# --- Component settings ---
WAZUH_ALERT_MIN_LEVEL=7
# Syslog sources (514/udp) the Wazuh manager accepts besides its own Docker
# networks (R-06): comma-separated IPv4 addresses or CIDRs, no spaces.
# Non-secret, derived by render-env.sh from the optional SYSLOG_ALLOWED_IPS
# in topology.env; empty by default. The manager's entrypoint turns each
# entry into an <allowed-ips> of the syslog <remote> block (Wazuh W1.1).
WAZUH_SYSLOG_ALLOWED_IPS=

# --- Wazuh credentials ---
# Indexer admin (Filebeat, bootstrap, wazuh-query.sh). Set in the indexer's
# security index on first start only; changing it later needs securityadmin.
INDEXER_ADMIN_USER=admin
INDEXER_ADMIN_PASSWORD=__secret__
# Wazuh API administrator (the image disables the other default users).
WAZUH_API_ADMIN_USER=wazuh-wui
WAZUH_API_ADMIN_PASSWORD=__secret__
# Password agents must present to enroll (port 1515); also used by the
# lab agent. Rotating it: change it here and in every agent, then
# scripts/soc.sh up core (recreates the manager).
WAZUH_ENROLLMENT_PASSWORD=__secret__
# Grafana UI administrator (applied on Grafana's first start only).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__secret__
# C2: read-only Wazuh API user for n8n (created by bootstrap.sh).
WAZUH_N8N_API_USER=n8n-api
WAZUH_N8N_API_PASSWORD=__secret__
# C8: read-only indexer user for Grafana (created by bootstrap.sh).
GRAFANA_INDEXER_USER=grafana-ro
GRAFANA_INDEXER_PASSWORD=__secret__
