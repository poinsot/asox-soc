    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "asox-metrics"
      },
      "description": "Mean time to detect, lab runs only (C11): t_event − t_attack_start, the attack-start marker (rule 100101) to the Wazuh alert. Alerts without t_attack_start (real alerts, or no marker found, A101 / X-43) are left out, not counted as zero.",
      "id": 2,
      "title": "MTTD",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [],
          "noValue": "No data",
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Average$/",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "text": {
          "valueSize": 36
        }
      },
      "pluginVersion": "12.4.11",
      "targets": [
        {
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "asox-metrics"
          },
          "query": "NOT outcome:contract-check AND (_exists_:t_attack_start)",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "t_alert",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "t_alert",
              "settings": {
                "script": "doc['t_event'].value.toInstant().toEpochMilli() - doc['t_attack_start'].value.toInstant().toEpochMilli()"
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "histogram",
              "field": "rule_level",
              "settings": {
                "interval": "1000",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
