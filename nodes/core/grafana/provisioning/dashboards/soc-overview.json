{
  "description": "ASOX starter dashboard (Phase 1): Wazuh alerts from the indexer. Owner: Grafana.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "wazuh-indexer"
      },
      "description": "Number of Wazuh alerts per time bucket (at least 1 minute), for the selected minimum level.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "1m",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "alias": "Alerts",
          "bucketAggs": [
            {
              "field": "timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "wazuh-indexer"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "rule.level:>=$min_level",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "timestamp"
        }
      ],
      "title": "Alerts over time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "wazuh-indexer"
      },
      "description": "The 100 most recent alerts for the selected minimum level. Alert ID is the Wazuh alert id (used by contracts C1 and C8).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rule"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Agent"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert ID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "bucketAggs": [],
          "datasource": {
            "type": "grafana-opensearch-datasource",
            "uid": "wazuh-indexer"
          },
          "metrics": [
            {
              "id": "1",
              "settings": {
                "size": "100"
              },
              "type": "raw_data"
            }
          ],
          "query": "rule.level:>=$min_level",
          "queryType": "lucene",
          "refId": "A",
          "timeField": "timestamp"
        }
      ],
      "title": "Recent alerts",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "timestamp",
                "agent.name",
                "rule.level",
                "rule.id",
                "rule.description",
                "id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "agent.name": 4,
              "id": 5,
              "rule.description": 3,
              "rule.id": 2,
              "rule.level": 1,
              "timestamp": 0
            },
            "renameByName": {
              "agent.name": "Agent",
              "id": "Alert ID",
              "rule.description": "Description",
              "rule.id": "Rule",
              "rule.level": "Level",
              "timestamp": "Time"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "Time"
              }
            ]
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 41,
  "tags": [
    "asox",
    "wazuh"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "0",
          "value": "0"
        },
        "description": "Only alerts with rule.level at or above this value",
        "hide": 0,
        "includeAll": false,
        "label": "Minimum level",
        "multi": false,
        "name": "min_level",
        "options": [
          {
            "selected": true,
            "text": "0",
            "value": "0"
          },
          {
            "selected": false,
            "text": "3",
            "value": "3"
          },
          {
            "selected": false,
            "text": "7",
            "value": "7"
          },
          {
            "selected": false,
            "text": "10",
            "value": "10"
          },
          {
            "selected": false,
            "text": "12",
            "value": "12"
          }
        ],
        "query": "0,3,7,10,12",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "SOC Overview",
  "uid": "asox-soc-overview",
  "version": 1
}
