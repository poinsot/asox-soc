<!--
  ASOX tuning (owner: Wazuh). Range 109000-109999 for new silencing rules;
  overwrites keep the built-in rule's own ID. Loaded last among the numbered
  files, after the built-in ruleset (README, "Rules: ID plan, files and groups").
  Every entry says why. Levels follow README "Alert levels" (W2.1).
  Copied into /var/ossec/etc/rules/ at every manager start.
-->

<!--
  W2.7, X-09: Security Configuration Assessment (built-in 0570-sca_rules.xml).
  An agent's first scan, at every new enrollment, reports every failed CIS
  check: about 130 alerts of 19007 at level 7 for one Ubuntu agent
  (2026-09-29), all sent to n8n through C1. Later scans only report changes.
  - 19007 (check failed) and 19004 (score below 50%) go to level 5: context
    for Grafana's compliance panels, indexed but not forwarded.
  - Kept as they are, so they still reach n8n: 19011 and 19014 (a check that
    got worse: passed or not applicable -> failed, level 9) and 19005 (score
    below 30%, level 9).
  Overwrites must repeat the whole rule; the group list is the built-in one,
  so n8n's `sca` group still applies. Re-check on a Wazuh upgrade.
-->
<group name="sca,gdpr_IV_35.7.d,pci_dss_2.2,nist_800_53_CM.1,tsc_CC7.1,tsc_CC7.2,">

  <rule id="19004" level="5" overwrite="yes">
    <if_sid>19001</if_sid>
    <field name="sca.score">^4\d|^3\d</field>
    <options>no_full_log</options>
    <description>SCA summary: $(sca.policy): Score less than 50% ($(sca.score))</description>
  </rule>

  <rule id="19007" level="5" overwrite="yes">
    <if_sid>19006</if_sid>
    <field name="sca.check.result">^failed</field>
    <options>no_full_log</options>
    <description>$(sca.policy): $(sca.check.title)</description>
  </rule>

</group>

<!--
  W3.5: Suricata engine events. "SURICATA STREAM ..." and "SURICATA ...
  invalid/truncated" signatures (gid 1, sid 22xxxxx) report TCP/IP oddities
  of Suricata's own stream tracking, not attacks; in a container lab they
  come from offloading and checksums. Silenced (level 0, not indexed).
-->
<group name="asox,suricata,ids,tuning,">

  <rule id="109010" level="0">
    <if_sid>101000, 101001, 101002</if_sid>
    <field name="alert.signature">^SURICATA STREAM |^SURICATA TCPv4 invalid checksum|^SURICATA UDPv4 invalid checksum</field>
    <description>ASOX tuning: Suricata engine event silenced: $(alert.signature)</description>
  </rule>

</group>

<!--
  W4.3: built-in 87702 (0540-pfsense_rules.xml), 18 firewall blocks in 45 s
  from one source, carries MITRE T1110 (brute force). Repeated blocks are
  scans, floods or a misconfigured client as often as brute force, and with
  T1110 n8n and TheHive would route every one to the ssh-bruteforce template.
  Same rule without the MITRE block; port scans have their own rule (103000,
  T1046). Overwrites repeat the whole rule; groups as in the built-in file.
-->
<group name="pfsense,">

  <rule id="87702" level="10" frequency="18" timeframe="45" ignore="240" overwrite="yes">
    <if_matched_sid>87701</if_matched_sid>
    <same_source_ip />
    <description>Multiple pfSense firewall blocks events from same source.</description>
    <group>multiple_blocks,pci_dss_1.4,pci_dss_10.6.1,gpg13_4.12,hipaa_164.312.a.1,hipaa_164.312.b,nist_800_53_SC.7,nist_800_53_AU.6,tsc_CC6.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

</group>
