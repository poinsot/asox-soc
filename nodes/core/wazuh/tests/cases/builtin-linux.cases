# Built-in Wazuh rules the lab scenarios (W1.5) and n8n's playbooks rely on.
# Not our rules: these cases catch a Wazuh upgrade that changes an ID, a level
# or a group n8n and TheHive route on. Levels and groups as of 4.14.8.
# Attacker addresses are documentation ranges (203.0.113.0/24, memo item 7).

case sshd single failed password
expect rule=5760 level=5 groups=sshd,authentication_failed decoder=sshd
log Oct  5 10:00:01 lab-agent sshd[1234]: Failed password for root from 203.0.113.10 port 4242 ssh2

case sshd brute force (8 failures, valid user)
expect rule=5763 level=10 groups=sshd,authentication_failures
repeat 8 Oct  5 10:00:01 lab-agent sshd[1234]: Failed password for root from 203.0.113.10 port 4242 ssh2

case sshd brute force (8 failures, invalid user)
expect rule=5712 level=10 groups=sshd,authentication_failures
repeat 8 Oct  5 10:00:01 lab-agent sshd[1234]: Failed password for invalid user admin from 203.0.113.11 port 4242 ssh2

case sshd accepted password
expect rule=5715 level=3 groups=sshd,authentication_success
log Oct  5 10:00:02 lab-agent sshd[1234]: Accepted password for labuser from 203.0.113.10 port 4242 ssh2

case sudo three wrong passwords
expect rule=5404 level=10 groups=sudo decoder=sudo
log Oct  5 10:00:03 lab-agent sudo: labuser : 3 incorrect password attempts ; TTY=pts/0 ; PWD=/home/labuser ; USER=root ; COMMAND=/bin/bash

case sudo to root
expect rule=5403 level=4 groups=sudo
log Oct  5 10:00:03 lab-agent sudo: labuser : TTY=pts/0 ; PWD=/home/labuser ; USER=root ; COMMAND=/bin/bash

case new user
expect rule=5902 level=8 groups=adduser decoder=useradd
log Oct  5 10:00:04 lab-agent useradd[2001]: new user: name=backdoor, UID=1001, GID=1001, home=/home/backdoor, shell=/bin/bash, from=/dev/pts/0

case new group
expect rule=5901 level=8 groups=adduser decoder=groupadd
log Oct  5 10:00:04 lab-agent groupadd[2000]: new group: name=backdoor, GID=1001

# Web access logs (X-38): one built-in decoder, web-accesslog, for Apache
# combined and nginx (file or syslog). It decodes srcip, url, protocol and the
# status as id; user agent, referer and X-Forwarded-For stay in full_log only.
case Apache combined line, 200
expect rule=31100 level=0 decoder=web-accesslog
log 198.51.100.7 - - [15/Oct/2026:19:20:01 +0000] "GET /index.php?id=1 HTTP/1.1" 200 512 "http://ref.example/" "Mozilla/5.0 (X11; Linux x86_64)"

case nginx main format with X-Forwarded-For, 404
expect rule=31101 level=5 decoder=web-accesslog
log 198.51.100.7 - - [15/Oct/2026:19:20:01 +0000] "GET /admin HTTP/1.1" 404 153 "-" "curl/8.5.0" "203.0.113.9"

case SQL injection attempt in the URL
expect rule=31103 level=7 decoder=web-accesslog
log 198.51.100.7 - - [15/Oct/2026:19:20:02 +0000] "GET /index.php?id=1%27%20union%20select%201,2-- HTTP/1.1" 400 226 "-" "sqlmap/1.8"

case SQL injection, 10 tries from one address (lab scenario web-attack)
expect rule=31152 level=10 decoder=web-accesslog
repeat 10 198.51.100.30 - - [19/Oct/2026:10:00:01 +0000] "GET /products.php?id=1%27%20UNION%20SELECT%20username,password%20FROM%20users-- HTTP/1.1" 500 312 "-" "sqlmap/1.8.4#stable (https://sqlmap.org) asox_run=abc-123"
