# Template for this node's .env. Do not copy by hand: scripts/render-env.sh
# renders .env from this file and topology.env (soc.sh init runs it).
#
# How render-env.sh fills each key:
#   - topology-derived keys (instance, URLs, BIND_ADDR, heaps, mem limits,
#     paths) are always recomputed from topology.env;
#   - value __secret__    : random secret generated once, then kept;
#   - value __bootstrap__ : filled by bootstrap.sh (API keys), then kept;
#   - value __from:<node>__ : copied from nodes/<node>/.env on this machine;
#   - anything else       : copied from this file (e.g. pinned image tags).
# Values below are the single-host / standard-profile defaults, which CI
# uses to validate the compose files.

# --- Instance (derived) ---
SOC_INSTANCE=asox
DEPLOY_MODE=single
MEM_PROFILE=standard
BIND_ADDR=127.0.0.1

# --- Service URLs (derived) ---
MISP_URL=https://misp-nginx:8443
# MISP's own base URL: how users and scripts reach it on the published port
# (https://localhost:9443 in single-host mode, https://<INTEL_HOST>:9443 in
# distributed mode). Used for links, redirects and the certificate name.
MISP_BASE_URL=https://localhost:9443

# --- Intra-node addresses (aliases on the node's own network) ---
MARIADB_HOSTNAME=mariadb
REDIS_HOSTNAME=redis
MISP_MODULES_URL=http://misp-modules

# --- Memory profile (derived) ---
MISP_CORE_MEM=900m
MISP_NGINX_MEM=100m
MISP_MODULES_MEM=400m
MARIADB_MEM=550m
# InnoDB buffer pool (MariaDB's cache, its "heap").
MARIADB_BUFFER_POOL=256M
REDIS_MEM=100m

# --- Pinned images (docs/decisions.md) ---
MISP_CORE_IMAGE=ghcr.io/misp/misp-docker/misp-core:v2.5.47
MISP_NGINX_IMAGE=ghcr.io/misp/misp-docker/misp-nginx:v2.5.47
MISP_MODULES_IMAGE=ghcr.io/misp/misp-docker/misp-modules:v3.0.10
MARIADB_IMAGE=mariadb:10.11.19
REDIS_IMAGE=valkey/valkey:7.2.14

# --- MISP ---
# Site administrator (UI login) and organisation (renamed from the default
# ORGNAME on first start). The password is re-applied at every start.
MISP_ADMIN_EMAIL=admin@asox.local
MISP_ADMIN_PASSWORD=__secret__
MISP_ORG=SOC
# Admin API key (40 characters), set by bootstrap.sh through MISP's CLI.
MISP_ADMIN_KEY=__bootstrap__
# Read-only user for Cortex's MISP analyzer (C7) and its API key.
MISP_CORTEX_USER=cortex@asox.local
MISP_CORTEX_API_KEY=__bootstrap__
# API key of the read-only user for n8n's warninglist check (C10); the user
# (misp-config.json's n8n.user) and the key are created by
# nodes/intel/misp/misp-config.sh apply, which bootstrap.sh intel runs.
MISP_N8N_API_KEY=__bootstrap__
# Encryption key of secrets stored in MISP's database (never change it).
MISP_ENCRYPTION_KEY=__secret__
MISP_GPG_PASSPHRASE=__secret__
# supervisord's local control interface inside misp-core.
MISP_SUPERVISOR_PASSWORD=__secret__

# --- MariaDB and Redis (Valkey) ---
MYSQL_PASSWORD=__secret__
MYSQL_ROOT_PASSWORD=__secret__
REDIS_PASSWORD=__secret__
