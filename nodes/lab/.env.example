# Template for this node's .env. Do not copy by hand: scripts/render-env.sh
# renders .env from this file and topology.env (soc.sh init runs it).
#
# How render-env.sh fills each key:
#   - topology-derived keys (instance, URLs, BIND_ADDR, heaps, mem limits,
#     paths) are always recomputed from topology.env;
#   - value __secret__    : random secret generated once, then kept;
#   - value __bootstrap__ : filled by bootstrap.sh (API keys), then kept;
#   - value __from:<node>__ : copied from nodes/<node>/.env on this machine;
#   - anything else       : copied from this file (e.g. pinned image tags).
# Values below are the single-host / standard-profile defaults, which CI
# uses to validate the compose files.

# --- Instance (derived) ---
SOC_INSTANCE=asox
DEPLOY_MODE=single
MEM_PROFILE=standard

# --- Service URLs (derived) ---
WAZUH_MANAGER_ADDR=wazuh-manager

# --- Agent ---
LAB_AGENT_NAME=lab-agent
# Copied from nodes/core/.env by render-env.sh. On a machine without the
# core node, paste the value from the core machine's nodes/core/.env.
WAZUH_ENROLLMENT_PASSWORD=__from:core__

# --- Memory profile (derived) ---
LAB_AGENT_MEM=100m
# Suricata (D49, R-07): same in both profiles; lab traffic doesn't change
# with the profile (docs/decisions.md A96).
SURICATA_MEM=750m

# --- Pinned versions (docs/decisions.md) ---
LAB_BASE_IMAGE=ubuntu:noble-20260911
WAZUH_AGENT_VERSION=4.14.8
SURICATA_IMAGE=jasonish/suricata:8.0.7
