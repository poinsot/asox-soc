# Machine-specific configuration and generated secrets (never commit)
topology.env
.env
nodes/*/.env

# Generated certificates (Wazuh, per core host)
nodes/core/certs/*
!nodes/core/certs/.gitkeep
*.pem
*.key

# Cortex analyzer job directory (host side)
nodes/cases/cortex/jobs/*
!nodes/cases/cortex/jobs/.gitkeep
# API keys of the online Cortex analyzers (see analyzer-keys.env.example there)
nodes/cases/cortex/analyzers/analyzer-keys.env

# Backups (may contain data and credentials)
backups/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# MISP certificate (per intel host)
nodes/intel/certs/*
!nodes/intel/certs/.gitkeep
CLAUDE.md
